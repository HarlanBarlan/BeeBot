# Virtual environments — machine-specific, rebuild via requirements.txt
.venv/
.venv-*/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Trained model checkpoints — big binaries, transfer separately (see PLAN.md)
# Use ** to match nested paths too (e.g., models/archive/imitation_epochs/*.pt)
models/**/*.pt
models/**/*.zip
models/**/*.pkl

# Gameplay recording data — big, machine-generated, not source
data/

# Training logs
logs/
*.log

# Path recordings — machine/user-specific
bridges/paths/*.json

# Snipped templates — resolution-sensitive, re-snip per machine (see docs/COMMANDS.md).
# Live-game templates: HUD readers, popups, dialogue rescue. Machine-local.
# Wiki-sourced templates (buff_*.png) stay tracked — they're not resolution-sensitive.
hud/probes/pollen_bar_frame.png
hud/probes/honey_display.png
hud/probes/popup_*.png
bridges/probes/dialogue_continue*.png
# Machine-tuned config (region bounds depend on Roblox window size)
hud/probes/buff_strip_bounds.txt

# Debug outputs
hud/probes/debug_*.png
*.tmp

# IDE / OS junk
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Anything with credentials or secrets — never commit
.env
*.pem
*.key
secrets/
